from abc import ABC, abstractmethod


class Lutador(ABC):

    @abstractmethod
    def obter_nome(self):
        pass

    @abstractmethod
    def obter_nivel_poder(self):
        pass

    @abstractmethod
    def atacar(self):
        pass


class Saiyajin(Lutador):
    def __init__(self, nome, nivel_poder):
        if nome == "":
            raise ValueError("O nome não pode ser vazio.")

        if nivel_poder <= 0:
            raise ValueError("O nível de poder deve ser positivo.")

        self.nome = nome
        self.nivel_poder = nivel_poder

    def obter_nome(self):
        return self.nome

    def obter_nivel_poder(self):
        return self.nivel_poder

    def atacar(self):
        print(
            self.nome,
            "realizou um ataque Saiyajin!"
        )


