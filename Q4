Class Produto:
    def __init__(self, nome, preço, quantidade):
        self.__nome = nome 
        self.__preço = preço
        self.__quantidade = quantidade 

#getters#
    def get_nome(self): #metódo público#
        return self.__nome #atributo privado#
    
    def get_preço(self):
        return self.__preço

    def get_quantidade(self):
        return self.__quantidade

#setters#
    def set_nome(self, novo_nome):
        return self.__nome = novo_nome
    
    def set_preço(novo_preço):
        return self.__preço = novo_preço

    def set_quantidade(self, nova_quantidade):
        return self.__quantidade = nova_quantidade 

